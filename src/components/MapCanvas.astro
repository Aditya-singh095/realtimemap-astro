---
---
<!--
  MapCanvas: fills parent #map-wrapper (position:relative, flex:1)
  Root uses position:absolute inset:0 to guarantee 100% height.
  UI overlays sit OUTSIDE the overflow:hidden map clip zone.
-->
<div style="position:absolute; inset:0;">

  <!-- ① MAP + clipped overlays -->
  <div id="map-perspective-wrapper" style="position:absolute; inset:0; overflow:hidden; transition: transform 0.6s cubic-bezier(0.25,0.1,0.25,1), perspective 0.6s;">
    <div id="map" style="position:absolute; inset:0; z-index:0;"></div>

    <!-- grid -->
    <div style="position:absolute; inset:0; pointer-events:none; z-index:2;
      background-image: linear-gradient(to right, var(--border) 1px, transparent 1px),
                        linear-gradient(to bottom, var(--border) 1px, transparent 1px);
      background-size:40px 40px; opacity:0.6;">
    </div>

    <!-- HUD top-left -->
    <div style="position:absolute; top:12px; left:12px; z-index:10; pointer-events:none; display:flex; flex-direction:column; gap:6px;">
      <div class="glass-panel" style="padding:6px 8px;">
        <div style="display:flex; align-items:center; gap:6px; font-family:monospace; font-size:8px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--text);">
          <div style="width:6px; height:6px; background:var(--accent); animation:pulse 2s infinite;"></div>
          SCAN: LIVE
        </div>
        <div id="hud-coords" style="font-family:monospace; font-size:8px; color:var(--accent); margin-top:4px; letter-spacing:0.06em;">
          LAT: --.----° | LON: --.----°
        </div>
      </div>
      <div class="glass-panel" style="padding:6px 8px;">
        <div style="font-family:monospace; font-size:8px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--text);">UPLINK: OPTIMAL</div>
        <div style="width:140px; height:2px; background:var(--bg5); border:1px solid var(--border); margin-top:4px;">
          <div id="hud-upBar" style="height:100%; background:var(--accent); width:75%; transition:width 0.6s ease-out;"></div>
        </div>
        <div id="hud-upPct" style="font-family:monospace; font-size:8px; color:var(--accent); margin-top:3px; letter-spacing:0.06em;">75% — 3 FEEDS LIVE</div>
      </div>
    </div>

    <!-- Crosshair center -->
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); pointer-events:none; z-index:5; opacity:0.2;">
      <div style="width:70px; height:70px; border:1px solid var(--accent); border-radius:50%; animation:spin 15s linear infinite;"></div>
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:30px; height:30px;">
        <div style="width:1px; height:30px; background:var(--accent); position:absolute; left:50%;"></div>
        <div style="height:1px; width:30px; background:var(--accent); position:absolute; top:50%;"></div>
      </div>
    </div>
  </div>

  <!-- ② RIGHT SIDE CONTROLS — outside overflow:hidden so dropdown is never clipped -->
  <div style="position:absolute; top:12px; right:12px; z-index:20; pointer-events:auto; display:flex; flex-direction:column; gap:6px; align-items:flex-end;">

    <!-- Layers button + dropdown -->
    <div style="position:relative;">
      <!-- Toggle button -->
      <button id="layer-panel-btn" type="button" class="map-ctrl-btn" style="
        display:flex; align-items:center; gap:6px;
        padding:5px 10px;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        border:1px solid var(--border2);
        color:var(--text2);
        font-family:monospace; font-size:8px; font-weight:700;
        letter-spacing:0.1em; text-transform:uppercase;
        cursor:pointer; backdrop-filter:blur(8px);
        transition: border-color 0.15s, color 0.15s;
      " onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
         onmouseout="this.style.borderColor='var(--border2)';this.style.color='var(--text2)'">
        <i class="ti ti-layers-subtract" style="font-size:11px;"></i>
        LAYERS
        <i class="ti ti-chevron-down" id="layer-chevron" style="font-size:9px; transition:transform 0.2s;"></i>
      </button>

      <!-- Dropdown panel -->
      <div id="layer-panel" style="
        display:none;
        position:absolute; top:calc(100% + 4px); right:0;
        min-width:200px;
        background:color-mix(in srgb, var(--bg) 95%, transparent);
        border:1px solid var(--border2);
        padding:10px 12px;
        box-shadow:0 8px 28px rgba(0,0,0,0.7);
        backdrop-filter:blur(14px);
      ">
        <div style="font-family:monospace; font-size:7px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:var(--text3); margin-bottom:8px;">DATA LAYERS</div>

        <!-- Row macro: icon / label / pill -->
        <div class="lrow" data-layer="flights">
          <i class="ti ti-plane" style="color:var(--text);"></i>
          <span>Aircraft</span>
          <span class="lpill active" data-layer="flights"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="ships">
          <i class="ti ti-ship" style="color:var(--yellow);"></i>
          <span>Maritime</span>
          <span class="lpill active" data-layer="ships"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="cables">
          <i class="ti ti-topology-ring" style="color:var(--accent);"></i>
          <span>Sub Cables</span>
          <span class="lpill active" data-layer="cables"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="pipelines">
          <i class="ti ti-git-branch" style="color:var(--red);"></i>
          <span>Pipelines</span>
          <span class="lpill active" data-layer="pipelines"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="satellites">
          <i class="ti ti-satellite" style="color:#b06aff;"></i>
          <span>Satellites</span>
          <span class="lpill" data-layer="satellites"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="military">
          <i class="ti ti-shield-check" style="color:#6b8e23;"></i>
          <span>Military Bases</span>
          <span class="lpill" data-layer="military"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="nuclear">
          <i class="ti ti-radioactive" style="color:#ff3a3a;"></i>
          <span>Nuclear Bunkers</span>
          <span class="lpill" data-layer="nuclear"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="cameras_city">
          <i class="ti ti-building-skyscraper" style="color:#ff3a7a;"></i>
          <span>City Cameras</span>
          <span class="lpill" data-layer="cameras_city"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="cameras_traffic">
          <i class="ti ti-car" style="color:#ffb84d;"></i>
          <span>Traffic Cameras</span>
          <span class="lpill" data-layer="cameras_traffic"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="cameras_port">
          <i class="ti ti-anchor" style="color:#4d94ff;"></i>
          <span>Marine Cameras</span>
          <span class="lpill" data-layer="cameras_port"><span class="lthumb"></span></span>
        </div>
        <div class="lrow" data-layer="cameras_airport">
          <i class="ti ti-plane" style="color:#ffb84d;"></i>
          <span>Aviation Cameras</span>
          <span class="lpill" data-layer="cameras_airport"><span class="lthumb"></span></span>
        </div>

        <!-- Tile mode -->
        <div style="border-top:1px solid var(--border); margin-top:8px; padding-top:8px;">
          <div style="font-family:monospace; font-size:7px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:var(--text3); margin-bottom:6px;">MAP TILE</div>
          <div style="display:flex; flex-wrap:wrap; gap:4px;">
            <button class="tbtn active-tile" id="tile-dark"      type="button">DARK</button>
            <button class="tbtn"             id="tile-satellite" type="button">SAT</button>
            <button class="tbtn"             id="tile-terrain"   type="button">TERRAIN</button>
            <button class="tbtn"             id="tile-osm"       type="button">OSM</button>
          </div>
        </div>

        <!-- View mode -->
        <div style="border-top:1px solid var(--border); margin-top:8px; padding-top:8px;">
          <div style="font-family:monospace; font-size:7px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:var(--text3); margin-bottom:6px;">VIEW MODE</div>
          <div style="display:flex; gap:4px;">
            <button class="tbtn active-tile" id="view-2d" type="button">2D</button>
            <button class="tbtn"             id="view-3d" type="button">3D</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Street View button -->
    <button id="streetview-btn" type="button" class="map-ctrl-btn" style="
      display:flex; align-items:center; gap:5px;
      padding:5px 10px;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      border:1px solid var(--border2);
      color:var(--text2);
      font-family:monospace; font-size:8px; font-weight:700;
      letter-spacing:0.1em; text-transform:uppercase;
      cursor:pointer; backdrop-filter:blur(8px);
      transition: border-color 0.15s, color 0.15s;
    " onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
       onmouseout="this.style.borderColor='var(--border2)';this.style.color='var(--text2)'">
      <i class="ti ti-walk" style="font-size:11px;"></i>
      STREET VIEW
    </button>

    <button id="share-map-btn" type="button" class="map-ctrl-btn" aria-label="Copy map link" style="
      display:flex; align-items:center; gap:5px;
      padding:5px 10px;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      border:1px solid var(--border2);
      color:var(--text2);
      font-family:monospace; font-size:8px; font-weight:700;
      letter-spacing:0.1em; text-transform:uppercase;
      cursor:pointer; backdrop-filter:blur(8px);
      transition: border-color 0.15s, color 0.15s;
    " onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'"
       onmouseout="this.style.borderColor='var(--border2)';this.style.color='var(--text2)'">
      <i class="ti ti-share-2" style="font-size:11px;"></i>
      SHARE VIEW
    </button>
  </div>

  <!-- ③ STREET VIEW OVERLAY — fullscreen immersive panel -->
  <div id="streetview-overlay" style="display:none; position:absolute; inset:0; z-index:50; background:var(--bg);">
    <div style="position:absolute; top:0; left:0; right:0; z-index:51; display:flex; align-items:center; justify-content:space-between; padding:8px 12px; background:color-mix(in srgb, var(--bg) 92%, transparent); border-bottom:1px solid var(--border2); backdrop-filter:blur(10px);">
      <div style="display:flex; align-items:center; gap:8px;">
        <i class="ti ti-walk" style="color:var(--accent); font-size:14px;"></i>
        <span style="font-family:monospace; font-size:9px; font-weight:700; color:var(--text); letter-spacing:0.1em; text-transform:uppercase;">Street View</span>
        <span id="sv-location" style="font-family:monospace; font-size:8px; color:var(--text3); letter-spacing:0.06em;"></span>
      </div>
      <button id="streetview-close" type="button" style="
        display:flex; align-items:center; gap:4px;
        padding:4px 10px;
        background:transparent;
        border:1px solid var(--border2);
        color:var(--text2);
        font-family:monospace; font-size:8px; font-weight:700;
        letter-spacing:0.1em; text-transform:uppercase;
        cursor:pointer;
        transition: all 0.15s;
      " onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'"
         onmouseout="this.style.borderColor='var(--border2)';this.style.color='var(--text2)'">
        <i class="ti ti-x" style="font-size:10px;"></i>
        CLOSE
      </button>
    </div>
    <div id="streetview-frame" style="position:absolute; inset:0; top:38px;"></div>
  </div>

  <!-- ④ CAMERA VIEWER OVERLAY -->
  <div id="camera-overlay" style="display:none; position:absolute; inset:0; z-index:50; background:rgba(0,0,0,0.85); backdrop-filter:blur(4px);">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:90%; max-width:720px;">
      <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 12px; background:var(--bg3); border:1px solid var(--border2); border-bottom:none;">
        <div style="display:flex; align-items:center; gap:8px;">
          <div style="width:8px; height:8px; background:#ff3a3a; border-radius:50%; animation:pulse 1.5s infinite;"></div>
          <span style="font-family:monospace; font-size:9px; font-weight:700; color:var(--red); letter-spacing:0.1em; text-transform:uppercase;">● LIVE</span>
          <span id="cam-title" style="font-family:monospace; font-size:9px; font-weight:700; color:var(--text); letter-spacing:0.06em;"></span>
        </div>
        <button id="camera-close" type="button" style="
          display:flex; align-items:center; gap:4px; padding:4px 10px;
          background:transparent; border:1px solid var(--border2); color:var(--text2);
          font-family:monospace; font-size:8px; font-weight:700; letter-spacing:0.1em;
          text-transform:uppercase; cursor:pointer; transition: all 0.15s;
        " onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'"
           onmouseout="this.style.borderColor='var(--border2)';this.style.color='var(--text2)'">
          <i class="ti ti-x" style="font-size:10px;"></i> CLOSE
        </button>
      </div>
      <div id="cam-frame" style="width:100%; aspect-ratio:16/9; background:var(--bg); border:1px solid var(--border2); position:relative; overflow:hidden;">
        <div id="cam-loading" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:8px;">
          <div style="width:30px; height:30px; border:2px solid var(--border2); border-top-color:var(--accent); border-radius:50%; animation:spin 1s linear infinite;"></div>
          <span style="font-family:monospace; font-size:8px; color:var(--text3); text-transform:uppercase; letter-spacing:0.1em;">Connecting to feed...</span>
        </div>
      </div>
      <div style="padding:8px 12px; background:var(--bg3); border:1px solid var(--border2); border-top:none; display:flex; justify-content:between; gap:12px;">
        <div style="flex:1;">
          <div style="font-family:monospace; font-size:7px; color:var(--text3); text-transform:uppercase; letter-spacing:0.1em;">LOCATION</div>
          <div id="cam-location" style="font-family:monospace; font-size:9px; color:var(--text); font-weight:700;"></div>
        </div>
        <div>
          <div style="font-family:monospace; font-size:7px; color:var(--text3); text-transform:uppercase; letter-spacing:0.1em;">STATUS</div>
          <div style="font-family:monospace; font-size:9px; color:var(--accent); font-weight:700;">STREAMING</div>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
  /* layer rows */
  .lrow {
    display:flex; align-items:center; gap:8px;
    padding:4px 0; border-bottom:1px solid var(--border);
    cursor:pointer; user-select:none;
  }
  .lrow:last-of-type { border-bottom:none; }
  .lrow > i { font-size:12px; width:14px; text-align:center; flex-shrink:0; }
  .lrow > span:nth-child(2) {
    flex:1;
    font-family:monospace; font-size:8px; font-weight:700;
    letter-spacing:0.08em; text-transform:uppercase; color:var(--text2);
  }
  .lrow:hover > span:nth-child(2) { color:var(--text); }

  /* toggle pill */
  .lpill {
    width:28px; height:14px; flex-shrink:0;
    background:var(--bg5); border:1px solid var(--border2);
    position:relative; display:block;
    transition:background 0.2s, border-color 0.2s;
  }
  .lpill.active { background:var(--accent-bg); border-color:var(--accent); }
  .lthumb {
    width:10px; height:10px;
    background:var(--text3);
    position:absolute; top:1px; left:1px;
    transition:left 0.2s, background 0.2s;
  }
  .lpill.active .lthumb { left:15px; background:var(--accent); }

  /* tile buttons */
  .tbtn {
    font-family:monospace; font-size:7px; font-weight:700;
    letter-spacing:0.08em; text-transform:uppercase;
    padding:3px 6px; border:1px solid var(--border2);
    color:var(--text2); background:transparent; cursor:pointer;
    transition:border-color 0.15s, color 0.15s, background 0.15s;
  }
  .tbtn:hover, .tbtn.active-tile {
    border-color:var(--accent) !important;
    color:var(--accent) !important;
    background:var(--accent-bg) !important;
  }

  /* 3D perspective mode */
  #map-perspective-wrapper.mode-3d {
    transform: perspective(1200px) rotateX(45deg) scale(1.15);
    transform-origin: center 70%;
  }
  #map-perspective-wrapper.mode-3d .leaflet-tile-pane {
    filter: saturate(0.6) contrast(1.3) brightness(0.95);
  }

  /* spin keyframe for crosshair */
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulse {
    0%,100% { opacity:1; }
    50%      { opacity:0.3; }
  }
</style>

<script>
  import '../scripts/map.ts';
</script>
