<div class="status-bar h-5 bg-accent flex items-center px-2.5 gap-3 shrink-0 z-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent w-[200%] animate-[slideIn_2s_linear_infinite] opacity-30"></div>
  <div class="font-mono text-[8px] font-bold tracking-[0.14em] uppercase text-accent-on relative z-10">
    v5.0.0-ASTRO
  </div>
  <div class="w-[1px] h-2.5 bg-accent-on/30 relative z-10"></div>
  <div id="status-feed-count" class="font-mono text-[8px] font-bold tracking-[0.14em] uppercase text-accent-on relative z-10 flex items-center gap-1">
    FLIGHTS: -- | SHIPS: -- | SATS: --
  </div>
  <div class="w-[1px] h-2.5 bg-accent-on/30 relative z-10"></div>
  <div class="font-mono text-[8px] font-bold tracking-[0.14em] uppercase text-accent-on relative z-10 flex items-center gap-1.5">
    <div class="w-1.5 h-1.5 bg-accent-on rounded-full animate-blink"></div> ALL FEEDS NOMINAL
  </div>
  <div class="ml-auto font-mono text-[8px] font-bold tracking-[0.14em] uppercase text-accent-on relative z-10 flex items-center gap-3">
    <span>SOURCES: USGS • OPENSKY • AIS • TLE</span>
    <span class="hidden sm:inline">|</span>
    <span class="hidden sm:inline">UPTIME: 99.97%</span>
  </div>
</div>
